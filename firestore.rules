rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isCoach() {
      return isAuthenticated() && request.auth.token.role == 'coach';
    }
    
    function isClientOwner(clientId) {
      return isAuthenticated() && (request.auth.uid == clientId || request.auth.token.clientId == clientId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isCoach());
      allow write: if false;
    }

    // Clients collection & subcollections
    match /clients/{clientId} {
      allow read: if isCoach() || isClientOwner(clientId);
      allow update: if isCoach() || (
        isClientOwner(clientId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'coachNote', 'nutriPlan', 'workPlan', 'coachStepsGoal', 'status', 'pauseReason', 'resumeDate'
        ])
      );
      allow create, delete: if isCoach();

      match /checkins/{checkinId} {
        allow read: if isCoach() || (isClientOwner(clientId) && !resource.data.deleted);
        allow create: if isCoach() || isClientOwner(clientId);
        allow update: if isCoach() || (
          isClientOwner(clientId) && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'deleted', 'deletedAt', 'deletedBy', 'deletionReason'
          ])
        );
        // Clients can NEVER delete check-ins. Only coach role is permitted.
        allow delete: if isCoach();
      }

      match /measurements/{measId} {
        allow read: if isCoach() || isClientOwner(clientId);
        allow write: if isCoach() || isClientOwner(clientId);
      }

      match /reports/{reportId} {
        allow read: if isCoach() || isClientOwner(clientId);
        allow write: if isCoach() || isClientOwner(clientId);
      }

      match /wins/{winId} {
        allow read: if isCoach() || isClientOwner(clientId);
        allow write: if isCoach() || isClientOwner(clientId);
      }

      match /onboarding/{docId} {
        allow read: if isCoach() || isClientOwner(clientId);
        allow write: if isCoach() || isClientOwner(clientId);
      }

      match /audit_logs/{auditId} {
        allow read: if isCoach();
        allow write: if isCoach();
      }
    }
  }
}
